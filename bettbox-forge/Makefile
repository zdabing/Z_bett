include $(TOPDIR)/rules.mk

PKG_NAME:=bettbox-forge
PKG_VERSION:=1.19.7
PKG_RELEASE:=1

PKG_MAINTAINER:=Bettbox for OpenWrt contributors
PKG_LICENSE:=GPL-3.0
PKG_LICENSE_FILES:=../LICENSE

# Source lives in this feed directory (no PKG_SOURCE download).
PKG_BUILD_DEPENDS:=rust/host
PKG_BUILD_PARALLEL:=1

# Cargo.lock is committed (generated by cargo 1.99 / verified by CI cargo check).
RUST_PKG_LOCKED:=1

include $(INCLUDE_DIR)/package.mk
include $(TOPDIR)/feeds/packages/lang/rust/rust-package.mk

define Package/bettbox-forge
  SECTION:=net
  CATEGORY:=Network
  SUBMENU:=Web Servers/Proxies
  TITLE:=Bettbox JS override script sandbox (Rust/boa)
  URL:=https://github.com/appshubcc/Bettbox
  DEPENDS:=$(RUST_ARCH_DEPENDS)
endef

define Package/bettbox-forge/description
  Runs Bettbox-compatible JS override scripts (main(config, customOptions)
  contract, ruleOptionsEnable toggles, Compatible_With_Bettbox header)
  against mihomo profile configs exported as JSON.

  CLI port of upstream Bettbox plugins/code_forge/rust. Engine is pure-Rust
  boa instead of QuickJS so it cross-compiles for every OpenWrt target
  (mips/mipsel/armv7-musl have no pregenerated rquickjs bindings and bindgen
  needs libclang on every build host).
endef

$(eval $(call RustBinPackage,$(PKG_NAME)))
$(eval $(call BuildPackage,$(PKG_NAME)))
