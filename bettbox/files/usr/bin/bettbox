#!/bin/sh
# SPDX-License-Identifier: GPL-3.0
# bettbox CLI dispatcher.

LIBEXEC=/usr/libexec/bettbox

usage() {
	cat >&2 <<EOF
usage: bettbox <command> [args]
  service
    start | stop | restart | reload          manage the core (procd)
    enable | disable                         autostart
  config
    apply                                    render + validate config
    apply-service                            apply saved settings and service state
    live                                     apply and hot-reload the core
    status                                   quick status summary
  subscriptions
    update <sid> | update-all | cron
    add <url> [label] | remove <sid>
  toolbox
    dns <name> [type] [follow|system|custom] [server]
    ip [direct|proxy] [ip]
    ping <host> [count] [interval] [tcpport]
    speedtest [down_bytes] [up_bytes]
    media
    trace <host>                          rule-match tracing
    mrs <domain>                          geosite reverse lookup
    nat                                   STUN mapping detection
    age encrypt <pub>|decrypt <ident>     data on stdin
    iperf <host> [seconds]
  extras
    core status | check | update | rollback   manage the independent Mihomo core
    package status | check | update           update Bettbox and LuCI APKs
    dashboard install | remove               zashboard external-ui
    backup create <file> | restore <file>    local tar backup
    backup push | pull | list                WebDAV (configure bettbox.backup.*)
    api <METHOD> <path> [json]               mihomo REST passthrough
EOF
	exit 2
}

[ $# -ge 1 ] || usage
cmd="$1"
shift

case "$cmd" in
package)
	umask 077
	exec ucode "$LIBEXEC/package-update.uc" "$@"
	;;
core)
	umask 077
	exec ucode "$LIBEXEC/core-update.uc" "$@"
	;;
start|stop|restart|reload|enable|disable)
	/etc/init.d/bettbox "$cmd"
	;;
apply)
	sh "$LIBEXEC/apply.sh" apply
	;;
live)
	sh "$LIBEXEC/apply.sh" live
	;;
apply-service)
	sh "$LIBEXEC/apply.sh" service
	;;
status)
	. "$LIBEXEC/common.sh"
	if [ -f "$BETTBOX_RUN/config.yaml" ]; then
		echo "config: ok"
	else
		echo "config: not rendered"
	fi
	echo "core: $(api_call GET /version 2>/dev/null || echo offline)"
	echo "mode: $(uci -q get bettbox.config.mode)"
	echo "profile: $(uci -q get bettbox.config.profile)"
	;;
update|update-all|cron|add|remove)
	sh "$LIBEXEC/subscription.sh" "$cmd" "$@"
	;;
subscription|subscriptions)
	# Accept commands written by older versions of cron.sh.
	sh "$LIBEXEC/subscription.sh" "$@"
	;;
dns|ip|ping|speedtest|media|trace|mrs|nat|age|iperf)
	sh "$LIBEXEC/toolbox.sh" "$cmd" "$@"
	;;
dashboard)
	sh "$LIBEXEC/dashboard.sh" "$1"
	;;
backup)
	sh "$LIBEXEC/backup.sh" "$1" "$2"
	;;
api)
	. "$LIBEXEC/common.sh"
	api_call "$@"
	;;
*)
	usage
	;;
esac
