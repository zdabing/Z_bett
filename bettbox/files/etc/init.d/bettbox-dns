#!/bin/sh /etc/rc.common
# Keep the runtime upstream file available before dnsmasq starts, even while
# the proxy is disabled. A WAN DNS change must also work while it is disabled.
START=18
STOP=89
USE_PROCD=1

start_service() {
	/usr/libexec/bettbox/dnsmasq.sh prepare || return 1
	procd_open_instance
	procd_set_param command /bin/sh /usr/libexec/bettbox/dnsmasq.sh watch
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
