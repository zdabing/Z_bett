#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0

START=99
STOP=10

USE_PROCD=1
NAME=bettbox
RUN_DIR=/var/run/bettbox

bettbox_render_config() {
	/usr/bin/bettbox apply
}

start_service() {
	[ "$(uci -q get bettbox.config.enabled)" = "1" ] || return 0

	mkdir -p "$RUN_DIR" /etc/bettbox/profiles /etc/bettbox/scripts /etc/bettbox/geo /etc/bettbox/state

	if ! bettbox_render_config; then
		logger -t "$NAME" "config render failed, not starting core"
		return 1
	fi

	/usr/libexec/bettbox/firewall.sh start
	/usr/libexec/bettbox/dnsmasq.sh apply
	/usr/libexec/bettbox/cron.sh ensure

	procd_open_instance core
	procd_set_param command /usr/bin/mihomo -d /etc/bettbox -f "$RUN_DIR/config.yaml"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param env GEOIP_DIR=/etc/bettbox/geo
	procd_close_instance

	if [ "$(uci -q get bettbox.config.watchdog)" = "1" ]; then
		procd_open_instance watchdog
		procd_set_param command /bin/sh /usr/libexec/bettbox/watchdog.sh
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi
}

stop_service() {
	/usr/libexec/bettbox/firewall.sh stop
	/usr/libexec/bettbox/dnsmasq.sh restore
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
	procd_add_reload_interface_trigger wan
}

restart() {
	stop
	start
}
