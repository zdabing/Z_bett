+		if len(rest) > 0 && rest[0] == "--nodes-only" {
+			nodesOnly = true
+			rest = rest[1:]
+		}
+		if len(rest) < 3 {
+			fmt.Fprintln(os.Stderr, "usage: mihomo bettbox-merge [--nodes-only] OUTPUT PREFIXES MEMBER...")
+			os.Exit(2)
+		}
+		report, err := bettbox.MergeFilesWithOptions(rest[0], rest[1], rest[2:], nodesOnly)
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		_ = json.NewEncoder(os.Stdout).Encode(report)
+		return
+	}
+	if len(args) > 0 && args[0] == "bettbox-parse-nodes" {
+		if len(args) != 2 {
+			fmt.Fprintln(os.Stderr, "usage: mihomo bettbox-parse-nodes INPUT")
+			os.Exit(2)
+		}
+		result, err := bettbox.ParseNodesFile(args[1])
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		_ = json.NewEncoder(os.Stdout).Encode(result)
+		return
+	}
+	if len(args) > 0 && args[0] == "bettbox-patch-nodes" {
+		if len(args) != 4 {
+			fmt.Fprintln(os.Stderr, "usage: mihomo bettbox-patch-nodes CONFIG NODES OUTPUT")
+			os.Exit(2)
+		}
+		if err := bettbox.PatchNodesFile(args[1], args[2], args[3]); err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		return
+	}
+	if len(args) > 0 && args[0] == "bettbox-register-warp" {
+		result := bettbox.RegisterWarpCLI()
+		_ = json.NewEncoder(os.Stdout).Encode(result)
+		if result.Error != "" {
