{
	"luci-app-bettbox": {
		"description": "Grant access to Bettbox",
		"read": {
			"ubus": {
				"bettbox": [
					"package_info",
					"package_check",
					"core_info",
					"core_check",
					"get_status",
					"get_profiles",
					"get_scripts",
					"get_script",
					"script_options",
					"script_check",
					"get_logs",
					"api_proxy",
					"toolbox_call",
					"get_network",
					"get_resources",
					"diagnostic_start",
					"diagnostic_status"
				]
			},
			"uci": [
				"bettbox"
			]
		},
		"write": {
			"ubus": {
				"bettbox": [
					"package_update",
					"core_update",
					"update_profile",
					"add_profile",
					"import_profile",
					"del_profile",
					"save_script",
					"del_script",
					"import_script_url",
					"set_script_source",
					"script_update",
					"apply",
					"service_action",
					"dashboard",
					"geo_update",
					"backup_call",
					"backup_file"
				]
			},
			"uci": [
				"bettbox"
			],
			"file": {
				"/tmp/bettbox-ui-backup.*": [
					"read",
					"write"
				]
			}
		}
	}
}
