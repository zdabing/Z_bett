# Keep router scripts executable by POSIX shells after a Windows checkout.
* text=auto eol=lf
*.png binary
*.jpg binary
*.woff2 binary
*.apk binary

# Preserve vendored SVG bytes so source SHA-256 records remain reproducible.
luci-app-bettbox/htdocs/luci-static/resources/bettbox/flags/*.svg -text whitespace=cr-at-eol
luci-app-bettbox/htdocs/luci-static/resources/bettbox/qure/*.svg -text whitespace=cr-at-eol
